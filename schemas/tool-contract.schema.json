{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidahmann/production-agent-engineering/schemas/tool-contract.schema.json",
  "title": "Agent tool contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "tool_id", "version", "owner", "purpose", "kind", "input_schema", "output_schema", "error_schema", "authorization", "execution", "side_effects", "approval", "network", "failure_modes", "observability", "invariants", "control_ids"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "tool_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "owner": { "type": "string", "minLength": 2 },
    "purpose": { "type": "string", "minLength": 10 },
    "kind": { "enum": ["query", "compute", "stage_write", "commit_write", "administrative"] },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "error_schema": { "type": "object" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_principal", "caller_context_required", "required_scopes", "policy_decision_point", "tenant_binding", "fail_mode"],
      "properties": {
        "agent_principal": { "type": "string", "minLength": 2 },
        "caller_context_required": { "type": "boolean" },
        "required_scopes": { "$ref": "#/$defs/nonEmptyStrings" },
        "policy_decision_point": { "type": "string", "minLength": 2 },
        "tenant_binding": { "type": "boolean" },
        "fail_mode": { "const": "closed" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "max_attempts", "retryable_errors", "idempotency"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "retryable_errors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "idempotency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "key_fields", "enforced_by"],
          "properties": {
            "required": { "type": "boolean" },
            "key_fields": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "enforced_by": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "resources", "compensation"],
      "properties": {
        "class": { "enum": ["none", "staged", "reversible", "irreversible"] },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "compensation": { "type": ["string", "null"] }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "role", "proposal_digest_required", "expires_seconds"],
      "properties": {
        "required": { "type": "boolean" },
        "role": { "type": ["string", "null"] },
        "proposal_digest_required": { "type": "boolean" },
        "expires_seconds": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["egress", "destinations", "credential_broker"],
      "properties": {
        "egress": { "enum": ["none", "allowlist"] },
        "destinations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "credential_broker": { "type": ["string", "null"] }
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "class", "retry", "escalate"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "class": { "enum": ["retryable", "terminal", "authorization", "validation", "escalation"] },
          "retry": { "type": "boolean" },
          "escalate": { "type": "boolean" }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_name", "audit_event", "redacted_fields", "postcondition_readback"],
      "properties": {
        "span_name": { "type": "string", "minLength": 3 },
        "audit_event": { "type": "string", "minLength": 3 },
        "redacted_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "postcondition_readback": { "type": "boolean" }
      }
    },
    "invariants": { "$ref": "#/$defs/nonEmptyStrings" },
    "control_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "query" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "execution": {
            "type": "object",
            "properties": {
              "idempotency": {
                "type": "object",
                "properties": {
                  "required": { "const": false },
                  "key_fields": { "type": "array", "maxItems": 0 }
                }
              }
            }
          },
          "side_effects": {
            "type": "object",
            "properties": {
              "class": { "const": "none" },
              "resources": { "type": "array", "maxItems": 0 },
              "compensation": { "type": "null" }
            }
          },
          "approval": {
            "type": "object",
            "properties": {
              "required": { "const": false },
              "role": { "type": "null" },
              "proposal_digest_required": { "const": false },
              "expires_seconds": { "type": "null" }
            }
          },
          "observability": {
            "type": "object",
            "properties": { "postcondition_readback": { "const": false } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "stage_write" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "authorization": {
            "type": "object",
            "properties": {
              "caller_context_required": { "const": true },
              "tenant_binding": { "const": true }
            }
          },
          "execution": {
            "type": "object",
            "properties": {
              "idempotency": {
                "type": "object",
                "properties": {
                  "required": { "const": true },
                  "key_fields": { "type": "array", "minItems": 1 }
                }
              }
            }
          },
          "side_effects": {
            "type": "object",
            "properties": {
              "class": { "const": "staged" },
              "resources": { "type": "array", "minItems": 1 },
              "compensation": { "type": "string", "minLength": 3 }
            }
          },
          "approval": {
            "type": "object",
            "properties": {
              "required": { "const": false },
              "role": { "type": "null" },
              "proposal_digest_required": { "const": false },
              "expires_seconds": { "type": "null" }
            }
          },
          "output_schema": {
            "type": "object",
            "required": ["required", "properties"],
            "properties": {
              "required": { "type": "array", "contains": { "const": "proposal_digest" } },
              "properties": {
                "type": "object",
                "required": ["proposal_digest"],
                "properties": { "proposal_digest": true }
              }
            }
          },
          "observability": {
            "type": "object",
            "properties": { "postcondition_readback": { "const": true } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "commit_write" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "authorization": {
            "type": "object",
            "properties": {
              "caller_context_required": { "const": true },
              "tenant_binding": { "const": true }
            }
          },
          "input_schema": {
            "type": "object",
            "required": ["required", "properties"],
            "properties": {
              "required": {
                "type": "array",
                "allOf": [
                  { "contains": { "const": "approval_id" } },
                  { "contains": { "const": "idempotency_key" } },
                  { "contains": { "const": "proposal_digest" } }
                ]
              },
              "properties": {
                "type": "object",
                "required": ["approval_id", "idempotency_key", "proposal_digest"],
                "properties": {
                  "approval_id": true,
                  "idempotency_key": true,
                  "proposal_digest": true
                }
              }
            }
          },
          "execution": {
            "type": "object",
            "properties": {
              "idempotency": {
                "type": "object",
                "properties": {
                  "required": { "const": true },
                  "key_fields": { "type": "array", "minItems": 1 }
                }
              }
            }
          },
          "side_effects": {
            "type": "object",
            "properties": {
              "class": { "enum": ["reversible", "irreversible"] },
              "resources": { "type": "array", "minItems": 1 }
            }
          },
          "approval": {
            "type": "object",
            "properties": {
              "required": { "const": true },
              "role": { "type": "string", "minLength": 2 },
              "proposal_digest_required": { "const": true },
              "expires_seconds": { "type": "integer", "minimum": 1 }
            }
          },
          "observability": {
            "type": "object",
            "properties": { "postcondition_readback": { "const": true } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "side_effects": {
            "type": "object",
            "properties": { "class": { "not": { "const": "none" } } },
            "required": ["class"]
          }
        },
        "required": ["side_effects"]
      },
      "then": {
        "properties": {
          "authorization": {
            "type": "object",
            "properties": {
              "caller_context_required": { "const": true },
              "tenant_binding": { "const": true }
            }
          },
          "execution": {
            "type": "object",
            "properties": {
              "idempotency": {
                "type": "object",
                "properties": {
                  "required": { "const": true },
                  "key_fields": { "type": "array", "minItems": 1 }
                }
              }
            }
          },
          "side_effects": {
            "type": "object",
            "properties": { "resources": { "type": "array", "minItems": 1 } }
          },
          "network": {
            "type": "object",
            "properties": {
              "egress": { "const": "allowlist" },
              "destinations": { "type": "array", "minItems": 1 },
              "credential_broker": { "type": "string", "minLength": 2 }
            }
          },
          "observability": {
            "type": "object",
            "properties": { "postcondition_readback": { "const": true } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "side_effects": {
            "type": "object",
            "properties": { "class": { "const": "reversible" } },
            "required": ["class"]
          }
        },
        "required": ["side_effects"]
      },
      "then": {
        "properties": {
          "side_effects": {
            "type": "object",
            "properties": { "compensation": { "type": "string", "minLength": 3 } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "side_effects": {
            "type": "object",
            "properties": { "class": { "const": "irreversible" } },
            "required": ["class"]
          }
        },
        "required": ["side_effects"]
      },
      "then": {
        "properties": {
          "kind": { "const": "commit_write" },
          "side_effects": {
            "type": "object",
            "properties": { "compensation": { "type": "null" } }
          },
          "approval": {
            "type": "object",
            "properties": {
              "required": { "const": true },
              "role": { "type": "string", "minLength": 2 },
              "proposal_digest_required": { "const": true },
              "expires_seconds": { "type": "integer", "minimum": 1 }
            }
          },
          "observability": {
            "type": "object",
            "properties": { "postcondition_readback": { "const": true } }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    }
  }
}
